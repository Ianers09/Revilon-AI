DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com

# Leave DATABASE_URL unset to use the free local SQLite database.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Ollama runs locally, so no API key or paid account is needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Only required when OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.trycloudflare.com

# Prints verification codes in the Django terminal (free local default).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Revilon AI <noreply@localhost>
